---
const { p } = Astro.props;
const href = `/projects/${p.slug}`;
---
<article class="reveal rule py-10 md:py-14">
  <div class="grid items-center gap-8 md:grid-cols-[1fr_1.25fr] md:gap-14">
    <div>
      <p class="label">{p.number} · {p.kind}</p>
      <h3 class="display mt-4 text-4xl md:text-5xl"><a href={href}>{p.name}</a></h3>
      <p class="mt-4 text-slate-300">{p.summary}</p>
      <dl class="mt-6 space-y-3 text-sm">
        <div class="flex gap-4"><dt class="w-16 shrink-0 text-muted">Status</dt><dd>{p.status}</dd></div>
        <div class="flex gap-4"><dt class="w-16 shrink-0 text-muted">Built with</dt><dd>{p.stack.join(', ')}</dd></div>
      </dl>
      <a href={href} class="btn btn-line mt-7">Read the case study →</a>
    </div>
    <a href={href} class="block overflow-hidden rounded-xl border border-line bg-surface">
      <img src={`/images/${p.images.desktop}`} alt={`${p.alt} on desktop`} width="1600" height="1000" loading="lazy" class="w-full transition duration-500 hover:scale-[1.02]" />
    </a>
  </div>
</article>
