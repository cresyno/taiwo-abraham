---
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
const isActive = (href) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="fixed inset-x-0 top-0 z-40 border-b border-line bg-ink/95">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" class="display text-2xl">Taiwo Abraham</a>

    <ul class="hidden items-center gap-8 text-sm md:flex">
      {links.map((l) => (
        <li><a href={l.href} class:list={['transition hover:text-white', isActive(l.href) ? 'text-white' : 'text-muted']}>{l.label}</a></li>
      ))}
    </ul>

    <button type="button" data-open-work class="btn btn-solid hidden md:inline-flex">Work with me</button>

    <details class="relative md:hidden">
      <summary class="list-none cursor-pointer rounded-lg border border-line px-3 py-1.5 text-sm [&::-webkit-details-marker]:hidden">Menu</summary>
      <div class="absolute right-0 top-full mt-3 flex w-56 flex-col gap-1 rounded-xl border border-line bg-surface p-2">
        {links.map((l) => (
          <a href={l.href} class:list={['rounded-lg px-3 py-2 hover:bg-white/5', isActive(l.href) && 'bg-white/5 text-white']}>{l.label}</a>
        ))}
        <button type="button" data-open-work class="btn btn-solid mt-2">Work with me</button>
      </div>
    </details>
  </nav>
</header>
