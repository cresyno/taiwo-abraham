---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent("Hi Taiwo, I saw your portfolio and I'd like a website.")}`;
const industries = ['Fashion', 'Events', 'Interiors', 'Fitness', 'Food', 'Salons', 'Real Estate', 'Schools'];
---
<Base title="Taiwo Abraham — Websites for Nigerian Businesses">
  <section class="relative mx-auto max-w-5xl px-5 pt-36 md:pt-44">
    <div class="blob h-72 w-72 bg-blue-600 -top-10 -left-20"></div>
    <div class="blob h-64 w-64 bg-sky-400 top-40 right-0" style="animation-delay:-6s"></div>

    <div class="grid items-center gap-14 md:grid-cols-2">
      <div>
        <p class="glass reveal inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs text-sky-200">
          <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
          Taking new projects · Ibadan, Nigeria
        </p>
        <h1 class="font-display reveal mt-6 text-5xl font-extrabold leading-[1.02] md:text-7xl">
          Websites that make customers <span class="shine">say yes.</span>
        </h1>
        <p class="reveal mt-6 max-w-md text-lg text-slate-300">
          I design and build fast, beautiful websites and online stores for Nigerian businesses, so people find you, trust you, and buy.
        </p>
        <div class="reveal mt-9 flex flex-wrap gap-3">
          <a href="/work" class="btn-primary">See my work →</a>
          <a href={wa} class="btn-ghost">Chat on WhatsApp</a>
        </div>
      </div>

      <!-- Floating browser mockup -->
      <div class="stage reveal relative">
        <div class="browser glass rounded-2xl p-4">
          <div class="mb-4 flex items-center gap-1.5">
            <i class="h-2.5 w-2.5 rounded-full bg-red-400/80"></i>
            <i class="h-2.5 w-2.5 rounded-full bg-yellow-300/80"></i>
            <i class="h-2.5 w-2.5 rounded-full bg-emerald-400/80"></i>
            <span class="ml-3 flex-1 rounded-md bg-white/5 px-3 py-1 text-[11px] text-slate-400">yourbusiness.com</span>
          </div>
          <div class="skel h-24"></div>
          <div class="mt-3 grid grid-cols-3 gap-3">
            <div class="skel h-20"></div><div class="skel h-20"></div><div class="skel h-20"></div>
          </div>
          <div class="skel mt-3 h-4 w-2/3"></div>
          <div class="skel mt-2 h-4 w-1/2"></div>
          <div class="btn-primary mt-4 w-full">Book now</div>
        </div>
        <span class="chip glass absolute -left-3 top-10 rounded-full px-3 py-1.5 text-xs">⚡ Live in 7 days</span>
        <span class="chip glass absolute -right-2 bottom-24 rounded-full px-3 py-1.5 text-xs" style="animation-delay:-2s">📱 Mobile-first</span>
        <span class="chip glass absolute -bottom-3 left-10 rounded-full px-3 py-1.5 text-xs" style="animation-delay:-3s">💳 Paystack-ready</span>
      </div>
    </div>
  </section>

  <!-- Industries marquee -->
  <section class="mt-28 overflow-hidden border-y border-white/10 py-5">
    <div class="marquee gap-12 text-slate-400">
      {[...industries, ...industries].map((i) => (
        <span class="font-display mx-6 text-2xl font-bold">{i} <span class="text-sky-400">✦</span></span>
      ))}
    </div>
  </section>
</Base>
