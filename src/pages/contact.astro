---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hi Taiwo, I found your portfolio.')}`;
const rows = [
  ['WhatsApp', site.whatsappDisplay, wa],
  ['Email', site.email, `mailto:${site.email}`],
];
---
<Base title="Contact | Taiwo Abraham Feranmi" description="Contact Taiwo Abraham Feranmi on WhatsApp or by email.">
  <section class="mx-auto max-w-4xl px-5 pt-16 md:pt-24">
    <p class="label">Contact</p>
    <h1 class="display mt-4 text-6xl md:text-8xl">Get in touch.</h1>
    <p class="mt-5 max-w-xl text-muted">WhatsApp is the fastest way to reach me. Email works too.</p>

    <div class="mt-12">
      {rows.map(([k, v, h]) => (
        <a href={h} class="rule group flex items-center justify-between gap-6 py-7">
          <span class="label">{k}</span>
          <span class="display text-2xl transition group-hover:text-accent md:text-4xl">{v}</span>
        </a>
      ))}
    </div>

    <div class="rule pt-10">
      <p class="max-w-md text-slate-300">Have a project in mind? Send me the details in one short form and I'll follow up personally.</p>
      <button type="button" data-open-work class="btn btn-solid mt-6">Work with me</button>
    </div>
  </section>
</Base>
